{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ],
  "compilerOptions": {
    "paths": {
      "@/controllers": [
        "./controllers"
      ],
      "@/controllers/*": [
        "./controllers/*"
      ],
      "@/models": [
        "./models"
      ],
      "@/models/*": [
        "./models/*"
      ],
      "@/views": [
        "./views"
      ],
      "@/views/*": [
        "./views/*"
      ],
      "@/services": [
        "./src/services"
      ],
      "@/services/*": [
        "./src/services/*"
      ],
      "@/context": [
        "./src/context"
      ],
      "@/context/*": [
        "./src/context/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/hooks": [
        "./src/hooks"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "noImplicitAny": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "allowJs": true,
    "noUnusedLocals": false,
    "strictNullChecks": false
  }
}
